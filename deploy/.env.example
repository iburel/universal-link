# Copy this file to `.env` (same directory) and fill it in: `docker compose`
# reads it automatically.
#
# Nothing here is confidential. The OIDC client — including the `client_secret`
# below — is published by the server in its deployment descriptor, so that a
# device can be set up from the server's address alone; for an installed
# application that secret identifies the app, it does not authenticate it (see
# doc/server-api.md, "Deployment descriptor"). No account credential, no device
# key, and no account key ever goes near this file.

# The server's public domain name — must resolve (A/AAAA) to this machine.
# Caddy obtains the TLS certificate for it. The clients' config.json will point to
# wss://<this-domain>/ws.
ONEDEVICE_DOMAIN=your-server.example.com

# OIDC issuer (Google) and the "Desktop application"-type OIDC client
# (see doc/server-deployment.md, step 1).
ONEDEVICE_OIDC_ISSUER=https://accounts.google.com
ONEDEVICE_OIDC_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Optional: Google requires it at the token exchange even under PKCE. Leave it
# empty for an IdP that wants none — the clients are then configured without one.
ONEDEVICE_OIDC_CLIENT_SECRET=

# Optional: the relays this deployment announces to its fleet, comma-separated
# URLs. The clients' relay setting is off by default; a device that belongs to
# this server uses the announced relays unless its own config says otherwise
# (an explicit local relay always wins). Leave empty to announce none: a
# server without a relay is a valid deployment. For the compose-hosted relay
# below, set both of these and see the `relay` service in docker-compose.yml:
# ONEDEVICE_RELAY_DOMAIN=relay.your-server.example.com
# ONEDEVICE_RELAYS=https://relay.your-server.example.com
ONEDEVICE_RELAYS=

# Optional: the role the announced relays play (#88). Unset, they also carry
# the payload bytes when two devices cannot reach each other directly - you
# pay that bandwidth. Set to a number of bytes, they are rendezvous-only
# above it: payloads up to the cap may still ride them (clipboard-sized
# things keep working everywhere), anything larger requires a direct path
# and fails cleanly otherwise ("NO_DIRECT_PATH", with the remedy on screen).
# `0` is the strict form. 1 MiB is a sensible starting point:
# ONEDEVICE_RELAY_MAX_PAYLOAD=1048576
# Enforced by every device of the fleet; pair it with the rate limit in
# iroh-relay.toml (see iroh-relay.toml.example) so the relay itself also
# protects your bill. Requires ONEDEVICE_RELAYS to be set.
