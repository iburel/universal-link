/target
/target-docker
/gui/gen
/gui/ui/node_modules
/gui/ui/dist
# Mobile frontend build (relative-base) — regenerated by the gui-mobile
# beforeBuildCommand; never versioned.
/gui/ui/dist-mobile
# Sidecar staged at release-build time (workflow); never versioned.
/gui/binaries
# gui-mobile has its own excluded Cargo.lock + target (its deps are already in
# the workspace lock); build artifacts must never enter the repo.
/gui-mobile/target

# Secrets and local configuration — must never enter the repository.
.env
*.env
!*.env.example
**/secrets.json
config.json
*.pem
*.key
!device.key.example
# The Android release signing key, and the password file the Tauri template would
# read it through. Not rotatable in practice — an APK signed by another key cannot
# upgrade an installed one, so a leaked key is leaked for the life of the app.
# release.yml gets it from a repository secret; it has no business in the tree, and
# gui-mobile/gen/android/.gitignore covers only its own subtree.
*.jks
*.p12
*.keystore
keystore.properties
key.properties
