<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service: keep the process (and the embedded Core's outbound
         network) alive while the app is backgrounded — the OIDC browser
         round-trip and P2P transfers run in the background, and aggressive OEM
         power managers (OnePlus/Oppo) otherwise suspend a backgrounded app's
         network within seconds. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hearing LAN discovery: the Wi-Fi driver drops incoming multicast unless
         an app holds a MulticastLock (LanMulticast), and without one the Core
         announces itself over mDNS but never hears its siblings. An
         install-time permission, granted silently. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Reading a pairing code off another device's screen (ScanActivity). Asked
         for at the moment of the gesture, never at startup, and the app works
         without it: a code can be pasted instead. The alternative that needs no
         permission at all is Google's code scanner, and ScanBridge says why it was
         not taken. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- NOT required: a camera is what one gesture uses, not what the app is for.
         Declaring it required would keep the app off a device with no camera —
         which is precisely a device that would pair by pasting the code. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.universallink_gui_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Share sheet: text shared from any app (a snippet, a link) is
                 copied to the account's clipboard. CATEGORY_DEFAULT is what
                 makes the filter match an implicit ACTION_SEND. The activity is
                 singleTask, so a share into the running app arrives at
                 onNewIntent and a cold one at onCreate — MainActivity handles
                 both. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share sheet: any file, sent to one device of the account (the
                 app asks which). `*/*` is what puts UniversalLink in every
                 share sheet — the filter above stays, and is not redundant: a
                 text/plain share carries no stream, so only that one matches
                 it (see MainActivity.handleShare, which routes on the stream,
                 not on the MIME type). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The camera, for reading a pairing code (ScanBridge/ScanActivity). Not
             exported: it is opened by this app alone, from the pairing screens.
             `configChanges` for the same reason MainActivity has it — a rotation
             must not recreate the window, which here would report the scan as
             cancelled and hand the camera back mid-gesture. -->
        <activity
          android:name=".ScanActivity"
          android:exported="false"
          android:label="@string/scan_title"
          android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode" />

        <service
          android:name=".UlForegroundService"
          android:exported="false"
          android:foregroundServiceType="dataSync" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
