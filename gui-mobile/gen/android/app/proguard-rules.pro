# R8 rules for the release build (`isMinifyEnabled` is set on that buildType
# only — see build.gradle.kts). Everything below the template's boilerplate is
# ours.

# Add project specific ProGuard rules here.
# You can control the set of applied configuration files using the
# proguardFiles setting in build.gradle.
#
# For more details, see
#   http://developer.android.com/guide/developing/tools/proguard.html

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Uncomment this to preserve the line number information for
# debugging stack traces.
#-keepattributes SourceFile,LineNumberTable

# If you keep the line number information, uncomment this to
# hide the original source file name.
#-renamesourcefileattribute SourceFile

# ---------------------------------------------------------------------------
# The JNI seams. Every one of them is reached BY NAME across a language
# boundary, so nothing in the Kotlin references them and R8's reachability
# analysis is blind to them. None of these failures shows up at build time.
# ---------------------------------------------------------------------------

# Rust -> Kotlin. `keepalive.rs` calls setWork through JNI on the class handed
# to it by nativeInit, looking the method up by its name and descriptor.
#
# Without this rule R8 does exactly what it is entitled to: it DELETES setWork
# from the release build (seen in build/outputs/mapping/universalRelease/
# usage.txt), and then — the method having been the only writer of `work` —
# proves that field constant and folds the UlForegroundService.onTaskRemoved
# guard away with it. The build stays green, the JNI lookup throws at runtime,
# keepalive.rs clears the exception as designed, and the foreground service is
# simply never started: every transfer and every login runs unprotected, which
# on this OEM means the OS is free to cut the network mid-work. A debug build
# never shows it (no minification), and neither does any test.
#
# The default android-optimize rules do NOT cover this: they preserve the names
# of *native* methods, which is why nativeInit survives — setWork is ordinary
# Kotlin, called from the other side.
-keep class org.universallink.mobile.KeepAlive {
    public static void setWork(int);
    native <methods>;
}

# Kotlin -> Rust. The .so exports
# `Java_org_universallink_mobile_ShareBridge_onShareText`, a symbol derived from
# the package, the class and the method name: renaming any of the three breaks
# the share sheet on the first share, at runtime.
#
# The tauri template happens to emit an equivalent rule of its own into the
# generated proguard-tauri.pro, which is what preserves these names today. That
# file is regenerated by the CLI and not ours to control, so the seam does not
# get to depend on it.
-keep class org.universallink.mobile.ShareBridge {
    native <methods>;
}

# Both ways, for the scanner (scan.rs). `startScan` is the one R8 would delete:
# it is ordinary Kotlin, called only from Rust, exactly like KeepAlive.setWork
# above — and the failure would be a "Scan a code" button that opens nothing.
# The native pair is the return path (nativeInit, onScanResult).
-keep class org.universallink.mobile.ScanBridge {
    public static boolean startScan(java.lang.String);
    native <methods>;
}
