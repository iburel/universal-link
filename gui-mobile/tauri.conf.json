{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1Device",
  "version": "0.6.0",
  "identifier": "org.onedevice.mobile",
  "build": {
    "beforeBuildCommand": "npm --prefix gui/ui run build:mobile",
    "frontendDist": "../gui/ui/dist-mobile"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "1Device"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "../gui/icons/32x32.png",
      "../gui/icons/128x128.png",
      "../gui/icons/128x128@2x.png",
      "../gui/icons/icon.icns",
      "../gui/icons/icon.ico"
    ]
  }
}
